# =============================================================================
# Dockerfile for PEX single-portable-binary build
# =============================================================================
# This creates a truly portable Python binary that requires NO Python
# installation on the target machine. The CPython interpreter is embedded
# via Python Standalone Builds (--scie eager).
#
# Key features:
#   --scie eager       - embed portable CPython (no internet at runtime)
#   --scie-pbs-stripped - remove debug symbols (~50% size reduction)
#   --scie-platform    - target platform
#   --scie-python-version - Python version for embedded interpreter
#
# Build:
#   docker buildx build -f Dockerfile.pex -t mcp-server-mattermost .
#
# Run (stdio mode):
#   docker run --rm -e MATTERMOST_URL=https://your-server.com \
#                        -e MATTERMOST_TOKEN=your-token \
#                        mcp-server-mattermost
#
# Run (HTTP mode for testing):
#   docker run --rm -p 8000:8000 \
#              -e MATTERMOST_URL=https://your-server.com \
#              -e MATTERMOST_TOKEN=your-token \
#              -e MCP_TRANSPORT=http \
#              mcp-server-mattermost
# =============================================================================

# -----------------------------------------------------------------------------
# Stage 1: Builder - create venv, then PEX with embedded Python
# -----------------------------------------------------------------------------
FROM python:3.12-slim AS builder

# Install uv for fast dependency management and pex for binary creation
RUN pip install --no-cache-dir uv pex

WORKDIR /build

# Copy dependency specs and README first (hatch needs README.md)
COPY pyproject.toml uv.lock README.md ./

# Copy source code
COPY src/ ./src/

# Sync dependencies into a venv (faster than pip, handles lock files)
RUN uv venv --python 3.12 /venv
RUN uv pip install --python /venv/bin/python -r /dev/stdin <<EOF
fastmcp>=3.0.0,<4
httpx>=0.28.0
pydantic>=2.0
pydantic-settings>=2.0
tenacity>=9.0.0
wsproto>=1.3.2
cachetools>=5.0
EOF

# Build wheel from source and install in venv
RUN uv pip install --python /venv/bin/python .

# Build PEX from the venv using --venv-repository
# This avoids network resolution issues and ensures compatibility
RUN pex \
    --venv-repository /venv \
    --venv \
    --scie eager \
    --scie-pbs-stripped \
    --scie-platform linux-x86_64 \
    -e mcp_server_mattermost:main \
    -o /build/mcp-server-mattermost

# -----------------------------------------------------------------------------
# Stage 2: Runtime - minimal image with PEX binary
# -----------------------------------------------------------------------------
# Note: The PEX binary is mostly self-contained but requires standard Linux
# libraries (libc, libpthread, etc.). We use a minimal base image.
FROM gcr.io/distroless/cc:nonroot AS runtime

# Copy the portable PEX binary
COPY --from=builder /build/mcp-server-mattermost /mcp-server-mattermost

# Default environment variables
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

# Default port for HTTP mode
EXPOSE 8000

# Entry point - the binary is mostly self-contained
ENTRYPOINT ["/mcp-server-mattermost"]

# Labels
LABEL org.opencontainers.image.title="MCP Server Mattermost (PEX)"
LABEL org.opencontainers.image.description="Portable single-binary MCP server for Mattermost - no Python required"
LABEL org.opencontainers.image.source="https://github.com/cloud-ru-tech/mcp-server-mattermost"
LABEL org.opencontainers.image.version="0.3.0"
LABEL org.opencontainers.image.created="2026-03-22"
